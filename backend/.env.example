# Template for backend/.env, which is gitignored. Copy it and fill in real
# values:
#
#     cd backend && cp .env.example .env
#
# Loaded by backend/app/security.py via python-dotenv, anchored to this
# directory so it works whether uvicorn runs from backend/ or pytest runs from
# the repo root. A real environment variable (CI, systemd, docker) always wins
# over a value set here.

# JWT signing key (HS256). Generate a fresh one with:
#     backend/.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every token already issued. If left unset, the app
# generates a throwaway key per process and logs a warning; it refuses to start
# without one when DEPLOYMENT_ENV/PRODUCTION/ENV marks production.
ANKH_SECRET_KEY=

ANKH_JWT_ALGORITHM=HS256

# Access token lifetime in minutes. 1440 = 24 hours.
ANKH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated CORS origins. This replaced allow_origins=["*"].
ANKH_ALLOWED_ORIGINS=http://localhost:3000

# Overrides the default sqlite:///backend/ankh_marketplace.db. This is the
# switch that points the app at the docker-compose Postgres. Left commented so
# the SQLite default stays in effect.
# DATABASE_URL=postgresql://ankh:ankh@localhost:5432/ankh_marketplace

# Set to mark a real deployment. Makes a missing ANKH_SECRET_KEY fatal instead
# of ephemeral, and stops app/ai_helper.py silently falling back to the keyword
# scorer when the local LLM fails.
# DEPLOYMENT_ENV=production
